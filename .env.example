# Copy this file to ".env" - every value is optional, the defaults below work out of the box.
SECRET_KEY=change-this-in-real-deployments
USE_REDIS=true                      # set false to skip Redis completely
REDIS_URL=redis://localhost:6379/0
DEMO_MODE=true                      # true = the OTP is also returned to the browser (so the demo works without SMS)
AUTO_SEED=true                      # create demo users + 75 days of history on first run
HOST=127.0.0.1
PORT=5000

# Optional: let Claude answer in the "Ask AI" tab (the offline assistant is used when this is empty)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
